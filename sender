local HS = game:GetService("HttpService")
local TS = game:GetService("TeleportService")
local P = game:GetService("Players")
local req = request or http_request or (http and http.request)

local hopActive = false
local lastHopTime = 0
local hopCooldown = 2 -- Sekunden zwischen Hops

local foundBrainrotsCache = {}
local cacheDuration = 30 -- Sekunden, wie lange ein Brainrot im Cache bleibt

local function getSvrs()
    local s, r = pcall(function() 
        return game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100") 
    end)
    
    if s and r then 
        local success, data = pcall(function() 
            return HS:JSONDecode(r) 
        end) 
        if success and data then 
            return data.data or {}
        end
    end
    return {}
end

local function hop()
    if hopActive or os.time() - lastHopTime < hopCooldown then return end
    
    hopActive = true
    lastHopTime = os.time()
    
    task.spawn(function()
        local svrs = getSvrs()
        local valid = {}
        
        for _, s in ipairs(svrs) do
            if s and s.id and s.playing and s.maxPlayers and s.playing < s.maxPlayers and s.id ~= game.JobId then
                table.insert(valid, s)
            end
        end
        
        if #valid > 0 then
            local randomServer = valid[math.random(#valid)]
            pcall(function() 
                TS:TeleportToPlaceInstance(game.PlaceId, randomServer.id, P.LocalPlayer) 
            end)
        end
        
        hopActive = false
    end)
end

local function parse(t)
    if not t then return 0 end
    
    -- Entferne alle Leerzeichen
    t = t:gsub("%s+", "")
    
    -- Finde die Zahl und Einheit
    local numberStr = t:match("([%d%.]+)")
    local unit = t:match("([MKBT])")
    
    if not numberStr then return 0 end
    
    local number = tonumber(numberStr) or 0
    
    if unit == "B" or unit == "b" then
        return number * 1e9
    elseif unit == "M" or unit == "m" then
        return number * 1e6
    elseif unit == "K" or unit == "k" then
        return number * 1e3
    elseif unit == "T" or unit == "t" then
        return number * 1e12
    end
    
    return number
end

local function sendToWebhook(webhookUrl, brainrot)
    local embed = {
        title = brainrot.name .. " - " .. brainrot.gen,
        description = "**Value:** " .. brainrot.gen .. 
                     "\n**Server ID:** " .. game.JobId .. 
                     "\n**Timestamp:** " .. os.date("%d/%m/%Y %H:%M:%S") ..
                     "\n**Player:** " .. P.LocalPlayer.Name,
        color = 5814783,
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
    }
    
    local img = IMG[string.lower(brainrot.name)]
    if img then 
        embed.thumbnail = {url = img} 
    end
    
    pcall(function() 
        req({
            Url = webhookUrl, 
            Method = "POST", 
            Headers = {["Content-Type"] = "application/json"}, 
            Body = HS:JSONEncode({embeds = {embed}})
        }) 
    end)
end

local function sendToValueWebhooks(value, brainrot)
    local webhookKey = ""
    
    if value >= 1000000000 then -- 1B+
        webhookKey = "1b+"
    elseif value >= 500000000 then -- 500M+
        webhookKey = "500m+"
    elseif value >= 100000000 then -- 100M+
        webhookKey = "100m+"
    elseif value >= 50000000 then -- 50M+
        webhookKey = "50m+"
    elseif value >= 10000000 then -- 10M+
        webhookKey = "10m+"
    end
    
    if webhookKey ~= "" and WEBHOOKS[webhookKey] then
        sendToWebhook(WEBHOOKS[webhookKey], brainrot)
    end
end

local function sendHighlights(brainrots)
    if #brainrots == 0 then return end
    
    table.sort(brainrots, function(a, b) return a.value > b.value end)
    
    local desc = "**" .. brainrots[1].name .. " (" .. brainrots[1].gen .. ")**\n\n"
    
    if #brainrots > 1 then
        desc = desc .. "```📈 Other Brainrots\n"
        for i = 2, math.min(#brainrots, 10) do
            desc = desc .. (i-1) .. "x " .. brainrots[i].name .. " (" .. brainrots[i].gen .. ")\n"
        end
        if #brainrots > 10 then
            desc = desc .. "... and " .. (#brainrots - 10) .. " more\n"
        end
        desc = desc .. "```\n"
    end
    
    desc = desc .. "**Server:** " .. game.JobId .. "\n"
    desc = desc .. os.date("%d/%m/%Y %H:%M")
    
    local emb = {
        description = desc,
        color = 5814783,
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
    }
    
    local img = IMG[string.lower(brainrots[1].name)]
    if img then emb.thumbnail = {url = img} end
    
    pcall(function() 
        req({
            Url = HIGHLIGHTS_URL, 
            Method = "POST", 
            Headers = {["Content-Type"] = "application/json"}, 
            Body = HS:JSONEncode({embeds = {emb}})
        }) 
    end)
end

local function scanAllLocations()
    local found = {}
    local currentTime = os.time()
    
    -- Durchsuche alle möglichen Orte wo Pets sein könnten
    local scanTargets = {
        game.Workspace,
        game:GetService("ReplicatedStorage"),
        game:GetService("Lighting"),
        game:GetService("SoundService"),
        game:GetService("StarterPack"),
        game:GetService("StarterGui"),
        game:GetService("Teams")
    }
    
    -- Füge Spieler-Inventare hinzu
    for _, player in pairs(P:GetPlayers()) do
        if player.Character then
            table.insert(scanTargets, player.Character)
        end
        if player:FindFirstChild("Backpack") then
            table.insert(scanTargets, player.Backpack)
        end
    end
    
    -- Erweiterte Suche in Workspace
    for _, target in pairs(scanTargets) do
        pcall(function()
            local descendants = target:GetDescendants()
            for _, obj in pairs(descendants) do
                if obj:IsA("TextLabel") and obj.Name == "Generation" and obj.Text then
                    local value = parse(obj.Text)
                    
                    if value >= MIN_VAL then
                        local parent = obj.Parent
                        local name = "Unknown"
                        
                        -- Versuche den Namen zu finden
                        if parent then
                            local displayName = parent:FindFirstChild("DisplayName")
                            if displayName and displayName:IsA("TextLabel") then
                                name = displayName.Text
                            else
                                -- Alternative: Suche nach anderen Namens-Labels
                                for _, child in pairs(parent:GetChildren()) do
                                    if child:IsA("TextLabel") and child.Name ~= "Generation" then
                                        name = child.Text
                                        break
                                    end
                                end
                                
                                if name == "Unknown" then
                                    name = parent.Name
                                end
                            end
                        end
                        
                        -- Cache-Schlüssel erstellen
                        local cacheKey = name .. "_" .. obj.Text .. "_" .. tostring(obj)
                        
                        -- Prüfe ob dieses Pet bereits im Cache ist
                        if not foundBrainrotsCache[cacheKey] or (currentTime - foundBrainrotsCache[cacheKey] > 5) then
                            local brainrot = {
                                name = name,
                                gen = obj.Text,
                                value = value
                            }
                            
                            -- Füge zum aktuellen Fund hinzu
                            table.insert(found, brainrot)
                            
                            -- Sende SOFORT an Value-Webhook
                            sendToValueWebhooks(value, brainrot)
                            
                            -- Aktualisiere Cache
                            foundBrainrotsCache[cacheKey] = currentTime
                            
                            print("Brainrot gefunden: " .. name .. " (" .. obj.Text .. ")")
                        end
                    end
                end
            end
        end)
    end
    
    -- Bereinige alten Cache
    for cacheKey, timestamp in pairs(foundBrainrotsCache) do
        if currentTime - timestamp > cacheDuration then
            foundBrainrotsCache[cacheKey] = nil
        end
    end
    
    return found
end

local function scan()
    local brainrots = scanAllLocations()
    
    if #brainrots > 0 then
        -- Sende Highlights
        sendHighlights(brainrots)
        
        -- Starte Hop nach kurzer Pause
        task.wait(0.5)
        hop()
        
        return true
    end
    
    return false
end

