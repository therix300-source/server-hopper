-- ==============================================================
-- FAST SCANNER
-- ==============================================================
local function fastScan()
    local tempAnimals = {}
    local currentTime = tick()
    local plots = workspace:FindFirstChild("Plots")
    
    if not plots then 
        allAnimalsCache = {}
        currentTopBrainrots = {}
        return 
    end
    
    -- Finde ALLE 10M+ Pets
    for _, plot in ipairs(plots:GetChildren()) do
        local success, channel = pcall(function()
            return Synchronizer:Get(plot.Name)
        end)
        
        if success and channel then
            local animalList = channel:Get("AnimalList")
            if animalList then
                for slot, animalData in pairs(animalList) do
                    if type(animalData) == "table" then
                        local animalName = animalData.Index
                        local animalInfo = AnimalsData[animalName]
                        if animalInfo then
                            local genValue = AnimalsShared:GetGeneration(animalName, animalData.Mutation, animalData.Traits, nil)
                            
                            if genValue >= WEBHOOK_THRESHOLD then
                                local displayName = animalInfo.DisplayName or animalName
                                local petKey = displayName .. "_" .. tostring(genValue)
                                
                                -- Prüfe ob dieser Pet neu ist
                                local isNewPet = not lastSentPets[petKey]
                                
                                table.insert(tempAnimals, {
                                    name = displayName,
                                    genValue = genValue,
                                    isHighValue = genValue >= EVERYONE_THRESHOLD,
                                    isNew = isNewPet
                                })
                                
                                -- SOFORT WEBHOOK für NEUE PETS
                                if isNewPet and currentTime - LAST_WEBHOOK_SENT >= WEBHOOK_COOLDOWN then
                                    lastSentPets[petKey] = true
                                    
                                    -- Sofortigen Webhook senden
                                    task.spawn(function()
                                        sendCapitanoWebhook(displayName, genValue, genValue >= EVERYONE_THRESHOLD)
                                    end)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    
    -- Update caches
    table.sort(tempAnimals, function(a, b)
        return a.genValue > b.genValue
    end)
    
    allAnimalsCache = tempAnimals
    
    -- Update top 8 für UI
    currentTopBrainrots = {}
    for i = 1, math.min(#allAnimalsCache, TOP_LIMIT) do
        currentTopBrainrots[i] = {
            name = allAnimalsCache[i].name,
            mps = allAnimalsCache[i].genValue,
            isHighValue = allAnimalsCache[i].isHighValue
        }
    end
    
    fastScanCount = fastScanCount + 1
    if fastScanCount >= 10 then -- Alle 10 Scans cleanup
        cleanupOldPets()
        fastScanCount = 0
    end
end

