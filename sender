    ["1B"] = 0xAA00FF         -- Purple
}

-- OPTIMIZED FUNCTIONS
local function formatMoneyShort(v)
    v = tonumber(v) or 0
    if v >= 1e12 then return string.format("%.2fT", v / 1e12) end
    if v >= 1e9 then return string.format("%.2fB", v / 1e9) end
    if v >= 1e6 then return string.format("%.2fM", v / 1e6) end
    if v >= 1e3 then return string.format("%.2fK", v / 1e3) end
    return string.format("%.0f", v)
end

local function getValueColor(value)
    if value >= 1000000000 then return VALUE_COLORS["1B"] end
    if value >= 500000000 then return VALUE_COLORS["500M"] end
    if value >= 250000000 then return VALUE_COLORS["250M"] end
    if value >= 100000000 then return VALUE_COLORS["100M"] end
    if value >= 50000000 then return VALUE_COLORS["50M"] end
    return VALUE_COLORS["10M"]
end

local function getValueTier(value)
    if value >= 1000000000 then return "[1B+ Tier]" end
    if value >= 500000000 then return "[500M+ Tier]" end
    if value >= 250000000 then return "[250M+ Tier]" end
    if value >= 100000000 then return "[100M+ Tier]" end
    if value >= 50000000 then return "[50M+ Tier]" end
    return "[10M+ Tier]"
end

