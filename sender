local function sendCapitanoWebhook(petName, petValue, isHighValue)
    local currentTime = tick()
    
    if currentTime - LAST_WEBHOOK_SENT < WEBHOOK_COOLDOWN then
        return
    end
    
    LAST_WEBHOOK_SENT = currentTime
    
    -- Check @everyone cooldown
    local shouldTagEveryone = isHighValue
    if shouldTagEveryone and currentTime - LAST_EVERYONE_TAG < EVERYONE_COOLDOWN then
        shouldTagEveryone = false
    elseif shouldTagEveryone then
        LAST_EVERYONE_TAG = currentTime
    end
    
    local realJobId = game.JobId
    local playerCount = #Players:GetPlayers()
    local embedColor = getValueColor(petValue)
    local valueTier = getValueTier(petValue)
    
    -- Format Job ID für schöne Anzeige
    local formattedJobId = ""
    local jobIdStr = tostring(realJobId)
    local lines = math.ceil(#jobIdStr / 36)
    
    for i = 1, lines do
        local startPos = (i-1)*36 + 1
        local endPos = math.min(i*36, #jobIdStr)
        formattedJobId = formattedJobId .. jobIdStr:sub(startPos, endPos) .. "\n"
    end
    
    -- Teleport Link generieren
    local teleportUrl = string.format("https://www.roblox.com/games/start?placeId=%s&gameInstanceId=%s", PLACE_ID, realJobId)
    
    local embed = {
        {
            title = "🚨 BRAINROT NOTIFIER",
            color = embedColor,
            description = string.format("**%s** - **%s**", petName, formatMoneyShort(petValue)),
            fields = {
                { 
                    name = "🎮 Game Info", 
                    value = string.format("Place ID: `%s`", PLACE_ID), 
                    inline = false 
                },
                { 
                    name = "👥 Players", 
                    value = string.format("%d Online", playerCount), 
                    inline = true 
                },
                { 
                    name = "💰 Value", 
                    value = string.format("+ **%s**", formatMoneyShort(petValue)), 
                    inline = true 
                },
                { 
                    name = "🏆 Category", 
                    value = string.format("**%s**", valueTier), 
                    inline = true 
                },
                { 
                    name = "🆔 Job ID", 
                    value = string.format("```%s```", formattedJobId), 
                    inline = false 
                },
                { 
                    name = "⚡ Quick Actions", 
                    value = string.format("[Click Here to Join](%s)", teleportUrl), 
                    inline = false 
                }
            },
            footer = { 
                text = string.format("Get that bag! 🎁 | %s", os.date("%d/%m/%Y %H:%M")) 
            },
            thumbnail = { 
                url = "https://cdn.discordapp.com/attachments/1308897786296668302/1451242995713310721/Naughty-Naughty-Icon.png" 
            }
        }
    }
    
    -- @everyone nur bei 50M+
    local contentText = nil
    if shouldTagEveryone then
        contentText = string.format("@everyone **50M+ BRAINROT DETECTED!** 🚨")
    end
    
    local data = { 
        content = contentText,
        embeds = embed, 
        username = "Brainrot Notifier • v7.0",
        avatar_url = "https://cdn.discordapp.com/attachments/1308897786296668302/1451242995713310721/Naughty-Naughty-Icon.png"
    }
    
    local jsonData = HttpService:JSONEncode(data)
    
    -- Send webhook
    task.spawn(function()
        pcall(function()
            if syn and syn.request then
                syn.request({
                    Url = DISCORD_WEBHOOK_URL,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = jsonData
                })
            elseif request then
                request({
                    Url = DISCORD_WEBHOOK_URL,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = jsonData
                })
            elseif http_request then
                http_request({
                    Url = DISCORD_WEBHOOK_URL,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = jsonData
                })
            end
        end)
    end)
    
    print(string.format("🚨 WEBHOOK SENT: %s - %s/s (%s)", petName, formatMoneyShort(petValue), valueTier))
    if isHighValue then
        print("🔥 50M+ BRAINROT DETECTED!")
    end
end

