-- MAIN SCANNER FUNCTION
local function scanAnimals()
    if not modulesLoaded then
        print("⏳ Waiting for modules to load...")
        return
    end
    
    local allPets = {}
    local plots = workspace:FindFirstChild("Plots")
    
    if not plots then
        print("❌ No Plots folder found")
        allAnimalsCache = {}
        currentTopBrainrots = {}
        return
    end
    
    print(string.format("🔍 Scanning %d plots...", #plots:GetChildren()))
    
    -- Scan each plot
    for _, plot in ipairs(plots:GetChildren()) do
        local success, channel = pcall(function()
            return Synchronizer:Get(plot.Name)
        end)
        
        if success and channel then
            local animalList = channel:Get("AnimalList")
            
            if animalList and type(animalList) == "table" then
                for slot, animalData in pairs(animalList) do
                    if type(animalData) == "table" and animalData.Index then
                        local animalName = animalData.Index
                        local animalInfo = AnimalsData[animalName]
                        
                        if animalInfo then
                            -- Calculate pet value
                            local value = AnimalsShared:GetGeneration(
                                animalName,
                                animalData.Mutation or 0,
                                animalData.Traits or {},
                                nil
                            )
                            
                            if value and value > 0 then
                                local displayName = animalInfo.DisplayName or animalName
                                
                                table.insert(allPets, {
                                    name = displayName,
                                    value = value,
                                    rawName = animalName,
                                    mutation = animalData.Mutation or 0,
                                    traits = animalData.Traits or {}
                                })
                            end
                        end
                    end
                end
            end
        else
            print("⚠️ Failed to get channel for plot:", plot.Name)
        end
    end
    
    -- Sort pets by value
    table.sort(allPets, function(a, b)
        return (a.value or 0) > (b.value or 0)
    end)
    
    -- Update cache
    allAnimalsCache = allPets
    currentTopBrainrots = {}
    
    for i = 1, math.min(#allPets, TOP_LIMIT) do
        currentTopBrainrots[i] = allPets[i]
    end
    
    -- Group pets by category for webhooks
    if #allPets > 0 then
        local categories = {
            ["10m"] = {},
            ["50m"] = {},
            ["100m"] = {},
            ["500m"] = {},
            ["1b"] = {},
            ["highlights"] = {}
        }
        
        for _, pet in ipairs(allPets) do
            local cat = getCategory(pet.value)
            
            -- Add to regular category
            if cat and categories[cat] then
                table.insert(categories[cat], pet)
            end
            
            -- Add to highlights if 100M+
            if pet.value and pet.value >= 100000000 then
                table.insert(categories["highlights"], pet)
            end
        end
        
        -- Send webhooks for each category with pets
        for cat, pets in pairs(categories) do
            if #pets > 0 then
                task.spawn(function()
                    sendWebhook(cat, pets)
                end)
                
                -- Small delay between webhooks
                task.wait(0.5)
            end
        end
        
        print(string.format("📊 Scan complete: Found %d pets total", #allPets))
    else
        print("📊 Scan complete: No pets found")
    end
end

