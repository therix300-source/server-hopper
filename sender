local ui = createSimpleUI()

local function updateUI()
    if not ui or not ui.Parent then return end
    
    local frame = ui:FindFirstChildOfClass("Frame")
    if not frame then return end
    
    local topPet = frame:FindFirstChild("TopPet")
    local topValue = frame:FindFirstChild("TopValue")
    local statsLabel = frame:FindFirstChild("Stats")
    local webhookLabel = frame:FindFirstChild("Webhook")
    
    if topPet and topValue and statsLabel and webhookLabel then
        if #currentTopBrainrots > 0 then
            topPet.Text = currentTopBrainrots[1].name
            topValue.Text = formatMoneyShort(currentTopBrainrots[1].mps) .. "/s"
            
            -- Count high value brainrots
            local highValueCount = 0
            for _, brainrot in ipairs(currentTopBrainrots) do
                if brainrot.mps >= EVERYONE_THRESHOLD then
                    highValueCount = highValueCount + 1
                end
            end
            
            -- Color coding based on value
            local topValueNum = currentTopBrainrots[1].mps
            if topValueNum >= 1000000000 then
                topValue.TextColor3 = Color3.fromRGB(170, 0, 255) -- Purple
            elseif topValueNum >= 500000000 then
                topValue.TextColor3 = Color3.fromRGB(255, 0, 255) -- Magenta
            elseif topValueNum >= 100000000 then
                topValue.TextColor3 = Color3.fromRGB(255, 50, 50) -- Red
            elseif topValueNum >= 50000000 then
                topValue.TextColor3 = Color3.fromRGB(255, 150, 50) -- Orange
            else
                topValue.TextColor3 = Color3.fromRGB(100, 255, 150) -- Green
            end
            
            statsLabel.Text = string.format("%d brainrots • %d over 50M+", 
                #allAnimalsCache, highValueCount)
                
            if highValueCount > 0 then
                statsLabel.TextColor3 = Color3.fromRGB(255, 150, 50)
            else
                statsLabel.TextColor3 = Color3.fromRGB(200, 200, 255)
            end
        else
            topPet.Text = "No brainrots detected"
            topValue.Text = "0/s"
            topValue.TextColor3 = Color3.fromRGB(150, 150, 150)
            statsLabel.Text = "0 brainrots • 0 over 50M+"
            statsLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
        end
        
        -- Webhook status
        local currentTime = tick()
        local cooldownLeft = math.max(0, LAST_WEBHOOK_SENT + WEBHOOK_COOLDOWN - currentTime)
        
        if cooldownLeft > 0 then
            webhookLabel.Text = string.format("⏱ Cooldown: %ds", math.ceil(cooldownLeft))
            webhookLabel.TextColor3 = Color3.fromRGB(255, 150, 50)
        else
            webhookLabel.Text = "🔔 Webhook: READY"
            webhookLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        end
    end
end

