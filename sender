            },
            thumbnail = { 
                url = PET_IMAGES[currentTopBrainrots[1] and currentTopBrainrots[1].name] or PET_IMAGES["default"] 
            }
        }
    }
    
    -- @everyonly NUR bei 50M+ Pets
    local contentText = nil
    if shouldTagEveryone then
        contentText = string.format("@everyone **%d BRAINROTS OVER 50M+!** 🔥", highValueCount)
    end
    
    local data = { 
        content = contentText,
        embeds = embed, 
        username = "Brainrot Notify • v6.1",
        avatar_url = PET_IMAGES["default"]
    }
    
