-- ============= BRAINROT SCANNING FUNCTIONS =============
local function parse(t)
    local n = tonumber(t:match("[%d%.]+")) or 0
    if t:find("B") then return n * 1e9 end
    if t:find("M") then return n * 1e6 end
    if t:find("K") then return n * 1e3 end
    return n
end

local function sendToValueWebhooks(value, brainrot)
    local webhookKey = ""
    
    if value >= 1000000000 then
        webhookKey = "1b+"
    elseif value >= 500000000 then
        webhookKey = "500m+"
    elseif value >= 100000000 then
        webhookKey = "100m+"
    elseif value >= 50000000 then
        webhookKey = "50m+"
    elseif value >= 10000000 then
        webhookKey = "10m+"
    end
    
    if webhookKey ~= "" and WEBHOOKS[webhookKey] then
        local embed = {
            title = brainrot.name .. " - " .. brainrot.gen,
            description = "**Value:** " .. brainrot.gen .. "\n**Server ID:** " .. game.JobId .. "\n**Timestamp:** " .. os.date("%d/%m/%Y %H:%M:%S"),
            color = 5814783,
            footer = {text = webhookKey .. " Brainrot Found!"}
        }
        
        local img = IMG[string.lower(brainrot.name)]
        if img then embed.thumbnail = {url = img} end
        
        pcall(function() 
            req({
                Url = WEBHOOKS[webhookKey], 
                Method = "POST", 
                Headers = {["Content-Type"] = "application/json"}, 
                Body = HttpService:JSONEncode({embeds = {embed}})
            }) 
        end)
    end
end

local function scanBrainrots()
    print('[🔍] Scanning for brainrots...')
    local br = {}
    
    for _, o in pairs(game.Workspace:GetDescendants()) do
        if o.Name == "Generation" and o:IsA("TextLabel") then
            local v = parse(o.Text)
            stats.totalBrainrots += 1
            
            if v >= MIN_VAL then
                stats.valuableBrainrots += 1
                local p = o.Parent
                local brainrot = {
                    name = p:FindFirstChild("DisplayName") and p.DisplayName.Text or "Unknown",
                    gen = o.Text,
                    value = v
                }
                table.insert(br, brainrot)
                sendToValueWebhooks(v, brainrot)
            end
        end
    end
    
    if #br > 0 then
        print(string.format('[💎] Found %d valuable brainrot(s)!', #br))
        table.sort(br, function(a, b) return a.value > b.value end)
        
        local desc = "**" .. br[1].name .. " (" .. br[1].gen .. ")**\n\n"
        
        if #br > 1 then
            desc = desc .. "```📋 Other Brainrots\n"
            for i = 2, #br do
                desc = desc .. i-1 .. "x " .. br[i].name .. " (" .. br[i].gen .. ")\n"
            end
            desc = desc .. "```\n"
        end
        
        desc = desc .. os.date("%d/%m/%Y %H:%M")
        
        local emb = {
            description = desc,
            color = 5814783
        }
        
        local img = IMG[string.lower(br[1].name)]
        if img then emb.thumbnail = {url = img} end
        
        pcall(function() 
            req({
                Url = HIGHLIGHTS_URL, 
                Method = "POST", 
                Headers = {["Content-Type"] = "application/json"}, 
                Body = HttpService:JSONEncode({embeds = {emb}})
            }) 
        end)
    else
        print('[ℹ️] No valuable brainrots found')
    end
    
    return #br > 0
end

-- ============= Smart Game Loading =============
local function fastGameLoad()
    local t0 = tick()
    
    local tasks = {}
    
    table.insert(tasks, function()
        if not game:IsLoaded() then
            game.Loaded:Wait()
        end
        return true
    end)
    
    table.insert(tasks, function()
        local lp = LocalPlayer or fastWaitLP()
        return lp ~= nil
    end)
    
    table.insert(tasks, function()
        local lp = LocalPlayer or fastWaitLP()
        local char = lp.Character or lp.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart", 10)
        local hum = char:WaitForChild("Humanoid", 5)
        return hrp and hum
    end)
    
    local completed = 0
    for _, task in ipairs(tasks) do
        local success = pcall(function()
            return task()
        end)
        if success then completed += 1 end
    end
    
    task.wait(STABILITY_WAIT)
    
    local elapsed = tick() - t0
    print(string.format('[⚡] Loaded in %.2fs (%d/3 tasks)', elapsed, completed))
    
    return completed >= 2
end

