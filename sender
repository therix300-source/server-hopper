-- ============= Smart Teleport with Scanning =============
local function smartTeleport(jobId)
    if not state.running then return end
    if state.teleporting or state.scanning then 
        table.insert(state.serverQueue, jobId)
        return 
    end
    
    if not jobId or jobId == "" or jobId == state.currentJobId then
        return
    end
    
    -- SCAN BEFORE HOPPING
    state.scanning = true
    print('[🔍] Scanning current server before hop...')
    
    task.spawn(function()
        pcall(scanBrainrots)
        task.wait(SCAN_DELAY)
        
        state.scanning = false
        
        -- NOW HOP
        print(string.format('[🚀] Hop #%d → %s', stats.hops + 1, jobId:sub(1, 8)))
        
        state.teleporting = true
        stats.hops += 1
        stats.lastHopTime = tick()
        
        local success = pcall(function()
            TeleportService:TeleportToPlaceInstance(
                PLACE_ID_OVERRIDE or game.PlaceId,
                jobId,
                LocalPlayer
            )
        end)
        
        if not success then
            warn('[⚠] Teleport failed')
            state.teleporting = false
            stats.failures += 1
        end
    end)
end

-- ============= Queue Processor =============
task.spawn(function()
    while true do
        if #state.serverQueue > 0 and not state.teleporting and not state.scanning and state.running then
            local nextServer = table.remove(state.serverQueue, 1)
            smartTeleport(nextServer)
        end
        task.wait(0.1)
    end
end)

