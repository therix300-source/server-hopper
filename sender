-- UTILITY FUNCTIONS
local function formatNumber(num)
    if not num then return "0" end
    num = tonumber(num) or 0
    if num >= 1000000000 then
        return string.format("%.2fB", num / 1000000000)
    elseif num >= 1000000 then
        return string.format("%.2fM", num / 1000000)
    elseif num >= 1000 then
        return string.format("%.2fK", num / 1000)
    end
    return string.format("%.0f", num)
end

local function getCategory(value)
    if not value then return nil end
    if value >= 1000000000 then return "1b" end
    if value >= 500000000 then return "500m" end
    if value >= 100000000 then return "100m" end
    if value >= 50000000 then return "50m" end
    if value >= 10000000 then return "10m" end
    return nil
end

local function getChannelName(category)
    local names = {
        ["highlights"] = "# highlights",
        ["10m"] = "# 10m",
        ["50m"] = "# 50m", 
        ["100m"] = "# 100m",
        ["500m"] = "# 500m",
        ["1b"] = "# 1b"
    }
    return names[category] or category
end

