local ui = createSimpleUI()

local function updateUI()
    if not ui or not ui.Parent then return end
    
    local frame = ui:FindFirstChildOfClass("Frame")
    if not frame then return end
    
    local topPet = frame:FindFirstChild("TopPet")
    local topValue = frame:FindFirstChild("TopValue")
    local countLabel = frame:FindFirstChild("Count")
    
    if topPet and topValue and countLabel then
        if #currentTopBrainrots > 0 then
            topPet.Text = currentTopBrainrots[1].name
            topValue.Text = formatMoneyShort(currentTopBrainrots[1].mps) .. "/s"
            
            -- Color coding
            if currentTopBrainrots[1].mps >= 100000000 then
                topValue.TextColor3 = Color3.fromRGB(255, 50, 50)
            elseif currentTopBrainrots[1].mps >= 50000000 then
                topValue.TextColor3 = Color3.fromRGB(255, 150, 50)
            else
                topValue.TextColor3 = Color3.fromRGB(100, 255, 150)
            end
        else
            topPet.Text = "No brainrots"
            topValue.Text = "$0/s"
            topValue.TextColor3 = Color3.fromRGB(150, 150, 150)
        end
        
        countLabel.Text = #allAnimalsCache .. " brainrots total"
    end
end

