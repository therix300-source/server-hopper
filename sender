-- OPTIMIZED FUNCTIONS
local function formatMoneyShort(v)
    v = tonumber(v) or 0
    if v >= 1e12 then return string.format("%.2fT", v / 1e12) end
    if v >= 1e9 then return string.format("%.2fB", v / 1e9) end
    if v >= 1e6 then return string.format("%.2fM", v / 1e6) end
    if v >= 1e3 then return string.format("%.2fK", v / 1e3) end
    return string.format("%.0f", v)
end

-- ==============================================================
-- FAST SCANNER
-- ==============================================================
local function fastScan()
    local tempAnimals = {}
    local plots = workspace:FindFirstChild("Plots")
    
    if not plots then 
        allAnimalsCache = {}
        currentTopBrainrots = {}
        return 
    end
    
    for _, plot in ipairs(plots:GetChildren()) do
        local success, channel = pcall(function()
            return Synchronizer:Get(plot.Name)
        end)
        
        if success and channel then
            local animalList = channel:Get("AnimalList")
            if animalList then
                for slot, animalData in pairs(animalList) do
                    if type(animalData) == "table" then
                        local animalName = animalData.Index
                        local animalInfo = AnimalsData[animalName]
                        if animalInfo then
                            local genValue = AnimalsShared:GetGeneration(animalName, animalData.Mutation, animalData.Traits, nil)
                            
                            if genValue >= WEBHOOK_THRESHOLD then
                                local displayName = animalInfo.DisplayName or animalName
                                
                                table.insert(tempAnimals, {
                                    name = displayName,
                                    genValue = genValue
                                })
                            end
                        end
                    end
                end
            end
        end
    end
    
    -- Sort and update
    table.sort(tempAnimals, function(a, b)
        return a.genValue > b.genValue
    end)
    
    allAnimalsCache = tempAnimals
    
    -- Update top 8
    currentTopBrainrots = {}
    for i = 1, math.min(#allAnimalsCache, TOP_LIMIT) do
        currentTopBrainrots[i] = {
            name = allAnimalsCache[i].name,
            mps = allAnimalsCache[i].genValue
        }
    end
end

-- ==============================================================
-- FAST WEBHOOK
-- ==============================================================
local function sendFastWebhook()
    local currentTime = tick()
    
    -- Cooldown check
    if currentTime - LAST_WEBHOOK_SENT < WEBHOOK_COOLDOWN then
        return false
    end
    
    if #currentTopBrainrots == 0 then
        return false
    end
    
    LAST_WEBHOOK_SENT = currentTime
    
    -- Check for @everyone
    local shouldTagEveryone = false
    for _, brainrot in ipairs(currentTopBrainrots) do
        if brainrot.mps >= EVERYONE_THRESHOLD then
            shouldTagEveryone = true
            break
        end
    end
    
    -- @everyone cooldown
    if shouldTagEveryone and currentTime - LAST_EVERYONE_TAG < EVERYONE_COOLDOWN then
        shouldTagEveryone = false
    elseif shouldTagEveryone then
        LAST_EVERYONE_TAG = currentTime
    end
    
    -- Build ranking text
    local rankingText = ""
    local emojiRanks = {"🥇", "🥈", "🥉", "4️⃣", "5️⃣", "6️⃣", "7️⃣", "8️⃣"}
    
    for i, brainrot in ipairs(currentTopBrainrots) do
        if i > TOP_LIMIT then break end
        
        local rankEmoji = emojiRanks[i] or string.format("%d.", i)
        local mpsText = formatMoneyShort(brainrot.mps)
        local fireEmoji = brainrot.mps >= EVERYONE_THRESHOLD and "🔥 " or ""
        
        rankingText = rankingText .. string.format("%s **%s**\n", rankEmoji, brainrot.name)
        rankingText = rankingText .. string.format("   └ %s`%s/s`\n\n", fireEmoji, mpsText)
    end
    
    -- Build embed
    local realJobId = game.JobId
    local embedColor = shouldTagEveryone and 0xFF0000 or 0xFF9900
    
    local embed = {
        {
            title = "🧠 BRAINROT ALERT • TOP 8",
            color = embedColor,
            description = string.format("**%d** brainrots found • **%s/s** top value",
                #allAnimalsCache,
                formatMoneyShort(currentTopBrainrots[1] and currentTopBrainrots[1].mps or 0)
            ),
            fields = {
                { 
                    name = "🏆 TOP RANKING", 
                    value = rankingText, 
                    inline = false 
                },
                { 
                    name = "📊 STATISTICS", 
                    value = "🎯 **Threshold:** 10M/s\n⚡ **Refresh:** 100ms\n🔥 **50M+ Alert:** Active", 
                    inline = true 
                },
                { 
                    name = "💰 TOTAL VALUE", 
                    value = string.format("**%s/s**\n%d pets over 10M/s",
                        formatMoneyShort(currentTopBrainrots[1] and currentTopBrainrots[1].mps or 0),
                        #currentTopBrainrots), 
                    inline = true 
                },
                { 
                    name = "🆔 JOB ID", 
                    value = string.format("```%s```", realJobId), 
                    inline = false 
                }
            },
            footer = { 
                text = string.format("v6.0 FAST • %s", os.date("%H:%M:%S")) 
            },
            thumbnail = { 
                url = PET_IMAGES[currentTopBrainrots[1] and currentTopBrainrots[1].name] or PET_IMAGES["default"] 
            }
        }
    }
    
    local data = { 
        content = shouldTagEveryone and "@everyone **50M+ BRAINROT DETECTED!** 🔥" or nil,
        embeds = embed, 
        username = "Brainrot Notify • v6.0",
        avatar_url = PET_IMAGES["default"]
    }
    
    local jsonData = HttpService:JSONEncode(data)
    
    -- Send webhook ASYNC
    task.spawn(function()
        pcall(function()
            if syn and syn.request then
                syn.request({
                    Url = DISCORD_WEBHOOK_URL,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = jsonData
                })
            elseif request then
                request({
                    Url = DISCORD_WEBHOOK_URL,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = jsonData
                })
            elseif http_request then
                http_request({
                    Url = DISCORD_WEBHOOK_URL,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = jsonData
                })
            end
        end)
    end)
    
    print("✅ Webhook sent with " .. #currentTopBrainrots .. " brainrots")
    if shouldTagEveryone then
        print("🔥 @everyone tagged!")
    end
    
    return true
end

